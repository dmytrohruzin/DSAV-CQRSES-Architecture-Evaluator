{
  "name": "@dbbs/vitest-config",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./base": "./src/base.ts",
    "./next": "./src/next.ts",
    "./react-library": "./src/react-library.ts",
    "./integration": "./src/integration.ts"
  },
  "scripts": {
    "clean": "node -e \"for (const p of ['.turbo', 'node_modules', 'dist']) require('node:fs').rmSync(p, {recursive: true, force: true, maxRetries: 3})\"",
    "check-types": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "*",
    "jsdom": "*",
    "vitest": "*"
  },
  "devDependencies": {
    "@dbbs/typescript-config": "*",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.6"
  }
}
