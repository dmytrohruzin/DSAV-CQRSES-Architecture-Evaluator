# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules

# Local env files
.env
.env.*
!.env.example

# Testing
**/coverage/
!.claude/skills/coverage/
playwright-report/
test-results/

# Turbo
.turbo

# Expo
.expo/

# Build Outputs
.next/
out/
build
dist

# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem

# IDE
.idea

# Claude Code
.claude/settings.local.json

# Git worktree sessions
.worktrees/

# Playwright MCP
.playwright-mcp/

# Reports
REQS-REPORT-*.md

# Certificates
localhost*.pem

# PDF docs (generated)
*.pdf

# Storybook
storybook-static/

# Sentry
.sentryclirc

# Cursor (track rules, ignore the rest)
.cursor/*
!.cursor/rules/

# Zed (track settings.json, ignore session/cache state)
.zed/*
!.zed/settings.json

# TypeScript build info
*.tsbuildinfo

# TypeScript compiled output (.d.ts, .d.ts.map, transpiled .js)
# Generated by tsc — should not be committed. Source .ts files are the truth.
*.d.ts.map
apps/**/*.d.ts
packages/**/*.d.ts
turbo/**/*.d.ts
apps/*/src/**/*.js
apps/*/e2e/**/*.js
packages/*/src/**/*.js
packages/*/src/**/*.js.map
apps/*/app/**/*.js
packages/*/src/**/*.js
turbo/generators/**/*.js
*.config.js
!eslint.config.js
!metro.config.js
!commitlint.config.js
infra/tf/keys/*
infra/tf/sources/*
infra/tf/.terraform/*
infra/tf/source.zip
infra/tf/terraform.tfstate.backup
