{
  "name": "@dbbs/dsav-cqrses-architecture-evaluator",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check-types": "tsc --noEmit",
    "clean": "node -e \"for (const p of ['.next', 'coverage', '.turbo', 'tsconfig.tsbuildinfo', 'node_modules', 'playwright-report']) fs.rmSync(p, { recursive: true, force: true, maxRetries: 3 })\""
  },
  "dependencies": {
    "@dbbs/logger": "*",
    "chart.js": "4.4.9",
    "chartjs-plugin-annotation": "3.1.0",
    "next": "16.3.6",
    "react": "19.2.6",
    "react-chartjs-2": "5.3.0",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@dbbs/typescript-config": "*",
    "@dbbs/vitest-config": "*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
