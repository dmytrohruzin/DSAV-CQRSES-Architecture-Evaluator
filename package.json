{
  "name": "@dbbs/platform-base",
  "version": "0.0.0",
  "private": true,
  "description": "AAA-class Turborepo monorepo boilerplate for Next.js, NestJS, and Expo",
  "license": "MIT",
  "author": "DBB Software",
  "repository": {
    "type": "git",
    "url": "https://github.com/DBB-Software/platform-base"
  },
  "keywords": [
    "turborepo",
    "monorepo",
    "boilerplate",
    "nextjs",
    "nestjs",
    "expo",
    "biome",
    "vitest"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && npm run clean:modules",
    "clean:modules": "node -e \"for (const p of ['node_modules', '.turbo', '.idea']) require('node:fs').rmSync(p, {recursive: true, force: true, maxRetries: 3})\"",
    "dev": "turbo run dev --concurrency=99",
    "start": "turbo run start --concurrency=99",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:unused": "knip",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "test:cov": "turbo run test:cov",
    "test:integration": "turbo run test:integration",
    "e2e": "turbo run e2e",
    "e2e:ui": "turbo run e2e:ui",
    "prepare": "lefthook install || true",
    "syncpack:fix": "syncpack fix-mismatches",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "^25.9.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^29.1.1",
    "knip": "^6.14.1",
    "lefthook": "2.1.7",
    "syncpack": "15.3.1",
    "turbo": "^2.9.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  },
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "http-proxy-agent": {
      "@tootallnate/once": "3.0.1"
    },
    "ajv": "8.18.0",
    "file-type": "21.3.1",
    "postcss": "^8.5.15"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "4.60.4"
  }
}
